@model Hospital.Models.Record.CreateRecordsViewModel

@{
    ViewData["Title"] = "Create Record";
}

<h1>Create Record</h1>

<form asp-action="Create" asp-controller="Record" method="post">
    <div class="form-group">
        <label asp-for="Record.IDPatient"></label>
        <select asp-for="Record.IDPatient" class="form-control" asp-items="@(new SelectList(Model.Patients, "ID", "Name"))">
            <option value="">Select Patient</option>
        </select>
        <span asp-validation-for="Record.IDPatient" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Record.IDDoctor"></label>
        <select asp-for="Record.IDDoctor" class="form-control" asp-items="@(new SelectList(Model.Doctors, "ID", "Name"))">
            <option value="">Select Doctor</option>
        </select>
        <span asp-validation-for="Record.IDDoctor" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Record.IDNurse"></label>
        <select asp-for="Record.IDNurse" class="form-control" asp-items="@(new SelectList(Model.Nurses, "ID", "Name"))">
            <option value="">Select Nurse</option>
        </select>
        <span asp-validation-for="Record.IDNurse" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Record.Diagnosis"></label>
        <input asp-for="Record.Diagnosis" class="form-control" />
        <span asp-validation-for="Record.Diagnosis" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Record.Prescription"></label>
        <input asp-for="Record.Prescription" class="form-control" />
        <span asp-validation-for="Record.Prescription" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Record.Treatment"></label>
        <input asp-for="Record.Treatment" class="form-control" />
        <span asp-validation-for="Record.Treatment" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Record</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
