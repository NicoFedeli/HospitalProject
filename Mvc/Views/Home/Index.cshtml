@{
    ViewData["Title"] = "Home Page";
}
@* Prendo i campi dei department *@
@using Hospital.Models.Enums;
@using Newtonsoft.Json; @* Per serializzare in JSON *@
@model Hospital.Models.Home.DashboardViewModel

@* Lista di Dipartimenti presenti nel sistema, ciascuno con un colore diverso *@
@{
    var departmentColors = new Dictionary<Department, string>
    {
        { Department.Cardiology, "bg-danger" },      // rosso
        { Department.Neurology, "bg-primary" },      // blu
        { Department.Pediatrics, "bg-warning" },     // giallo
        { Department.Emergency, "bg-success" },      // verde
        { Department.General, "bg-info" }            // azzurro
    };
}


<!DOCTYPE html>
<html lang="en">
<head>
    <!-- fullCalendar -->
    <link rel="stylesheet" href="~/plugins/fullcalendar/main.css">
</head>

@* var token = User.FindFirst("Token")?.Value; *@


<body class="hold-transition">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        @if (User.IsInRole("Doctor") || User.IsInRole("DoctorAdmin") || 
         User.IsInRole("Nurse") || User.IsInRole("NurseAdmin"))
        {
            <!-- Total Doctors -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-info">
                    <div class="inner">
						<h3>@Model.TotalDoctors</h3>
                        <p>Total Doctors</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>

			<!-- Total Nurses -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.TotalNurses</h3>
                        <p>Total Nurses</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-nurse"></i>
                    </div>
                    <a href="#" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
        }
        else if (User.IsInRole("Patient"))
        {
			<!-- Paid Bills -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@Model.PaidBills</h3>
                        <p>Paid Bills</p>
                    </div>
                    <div class="icon"><i class="fas fa-money-bill"></i></div>
                </div>
            </div>

			<!-- Unpaid Bills -->
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.UnpaidBills</h3>
                        <p>Unpaid Bills</p>
                    </div>
                    <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
                </div>
            </div>
		}
    </div>
    <!-- /.row -->

    <!-- /.row (main row) -->
    <div class="wrapper">
            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="sticky-top mb-3">
                                <!-- Departments Tag -->
                                <div class="card">
                                    <div class="card-header">
                                        <h4 class="card-title">Departments</h4>
                                    </div>
                                    <div class="card-body">
                                        <!-- the events -->
                                    <div id="external-events">
                                        @foreach (var department in Enum.GetValues(typeof(Department)))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm text-white w-100 mb-2 @departmentColors[(Department)department]"
                                                    data-department="@department"
                                                    style="font-size: 0.9rem; padding: 0.4em 0.8em; border-radius: 0.25rem; letter-spacing: 0.5px;">
                                                @department
                                            </button>
                                        }
                                    </div>
                                    </div>
                                    <!-- /.card-body -->
                                </div>

                                <!-- Appointment Detail-->
                                <div class="card" id="appointment-detail-card" style="display:none;">
                                    <div class="card-header">
                                        <h3 class="card-title">Appointment Detail</h3>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Doctor:</strong> <span id="detail-doctor"></span></p>
                                        <p><strong>Nurse:</strong> <span id="detail-nurse"></span></p>
                                        <p><strong>Patient:</strong> <span id="detail-patient"></span></p>
                                        <p><strong>Date:</strong> <span id="detail-date"></span></p>
                                        <p>
                                            <strong>Department:</strong>
                                            <span id="detail-department" style="font-weight: bold;"></span>
                                        </p>
                                    </div>
                                </div>                            
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-md-9">
                            <div class="card card-primary">
                                <div class="card-body p-0">
                                    <!-- THE CALENDAR -->
                                    <div id="calendar"></div>
                                </div>
                                <!-- /.card-body -->
                            </div>
                            <!-- /.card -->
                        </div>
                        <!-- /.col -->
                    </div>
                    <!-- /.row -->
                </div><!-- /.container-fluid -->
            </section>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->
    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap -->
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery UI -->
    <script src="~/plugins/jquery-ui/jquery-ui.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/dist/js/adminlte.min.js"></script>
    <!-- fullCalendar 2.2.5 -->
    <script src="~/plugins/moment/moment.min.js"></script>
    <script src="~/plugins/fullcalendar/main.js"></script>
    <!-- AdminLTE for demo purposes -->
    <script src="~/dist/js/demo.js"></script>
    <!-- Page specific script -->
    <script>
        $(function () {
          /* initialize the calendar
           -----------------------------------------------------------------*/
          var Calendar = FullCalendar.Calendar;
          var calendarEl = document.getElementById('calendar');

          const departmentColors = {
             Cardiology: '#dc3545',    // rosso
             Neurology: '#007bff',     // blu
             Pediatrics: '#ffc107',    // giallo
             Emergency: '#28a745',     // arancione
             General: '#17a2b8'        // verde
          };


          // Serializzo gli appuntamenti ricevuti dal server in una variabile JS
          var appointments = @Html.Raw(JsonConvert.SerializeObject(Model.Appointments));

          var calendar = new Calendar(calendarEl, {
            headerToolbar: {
              left  : 'prev,next today',
              center: 'title',
              right : 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            themeSystem: 'bootstrap',
            // Prepare events to fit into the
            events: appointments.map(item => ({
                id: item.ID,
                title: `${item.PatientName}`,
                start: item.Date,
                backgroundColor: departmentColors[item.Department] || '#999',
                borderColor: departmentColors[item.Department] || '#999',
                extendedProps: {
                  doctorUsername: item.DoctorName,
                  nurseUsername: item.NurseName,
                  patientUsername: item.PatientName,
                  department: item.Department
                }
            })),
            editable  : false,
            droppable : false, // this allows things to NOT be dropped onto the calendar !!!
                   
            eventClick: function(info) {     // 🔹 Quando clicchi su un evento
              const event = info.event;
              const props = event.extendedProps;
			  console.log('Event clicked:', event);
			  console.log('Extended Props:', props);
              // Popola la card
              document.getElementById('detail-doctor').innerText = props.doctorUsername;
              document.getElementById('detail-nurse').innerText = props.nurseUsername || '—';
              document.getElementById('detail-patient').innerText = props.patientUsername;
              document.getElementById('detail-date').innerText = new Date(event.start).toLocaleString();

              const deptEl = document.getElementById('detail-department');
              deptEl.innerText = props.department;
              deptEl.style.color = departmentColors[props.department] || '#000';
              // Mostra la card
              document.getElementById('appointment-detail-card').style.display = 'block';
            }
          });

          calendar.render();
          // $('#calendar').fullCalendar()
        })
    </script>
</body>
</html>