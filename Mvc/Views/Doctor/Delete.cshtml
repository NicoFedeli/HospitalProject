@{
    ViewData["Title"] = "Edit Doctors";
}
@using Hospital.Helpers;
@* @model Hospital.Models.Doctor.DoctorViewModel *@

@model Hospital.Models.Doctor.DoctorDeletePageViewModel;

@* Lista di Dipartimenti presenti nel sistema, ciascuno con un colore diverso *@
@{
    var departmentColors = DepartmentHelper.GetDepartmentColors();
    var departments = DepartmentHelper.GetDepartmentList().Select(d => d.Value);
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Total Doctors</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
                    <li class="breadcrumb-item active">Edit Doctor</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-12">
                <!-- Selezione del dottore -->
                <div class="form-group">
                    <label for="doctorSelect">Select a Doctor</label>
                    <select id="doctorSelect" class="form-control select2" style="width: 100%;">
                        <option selected disabled>-</option>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <option value="@doctor.ID" 
                                    data-name="@doctor.Name" 
                                    data-surname="@doctor.Surname" 
                                    data-username="@doctor.Username" 
                                    data-phone="@doctor.Phone" 
                                    data-speciality="@doctor.Speciality" 
                                    data-department="@doctor.Department"
                                    data-password="@doctor.password">
                                @doctor.Name @doctor.Surname (@doctor.Username)
                            </option>
                        }
                    </select>
                </div>

                <!-- Form di edit -->
                <form id="editDoctorForm" asp-action="Delete" asp-controller="Doctor" method="post">

                    <input type="hidden" asp-for="DoctorToDelete.ID" />

					<!-- Name -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Name"></label>
                        <input asp-for="DoctorToDelete.Name" class="form-control" />
                        <span asp-validation-for="DoctorToDelete.Name" class="text-danger"></span>
                    </div>

					<!-- Surname -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Surname"></label>
                        <input asp-for="DoctorToDelete.Surname" class="form-control" />
                        <span asp-validation-for="DoctorToDelete.Surname" class="text-danger"></span>
                    </div>
                    
                    <!-- Username -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Username"></label>
                        <input asp-for="DoctorToDelete.Username" class="form-control"/>
                        <span asp-validation-for="DoctorToDelete.Username" class="text-danger"></span> 
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Password"></label>
                        <input asp-for="DoctorToDelete.Password" class="form-control" />
                        <span asp-validation-for="DoctorToDelete.Password" class="text-danger"></span>
                    </div>

                    <!-- Speciality -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Speciality"></label>
                        <select asp-for="DoctorToDelete.Speciality" class="form-control" asp-items="SpecialityHelper.GetSpecialityList()">
                            <option value="">Select Speciality</option>
                        </select>
                        <span asp-validation-for="DoctorToDelete.Speciality" class="text-danger"></span>
                    </div>

                    <!-- Department -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Department"></label>
                        <select asp-for="DoctorToDelete.Department" class="form-control" asp-items="DepartmentHelper.GetDepartmentList()">
                            <option value="">Select Department</option>
                        </select>
                        <span asp-validation-for="DoctorToDelete.Department" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label asp-for="DoctorToDelete.Phone"></label>
                        <input asp-for="DoctorToDelete.Phone" class="form-control" />
                        <span asp-validation-for="DoctorToDelete.Phone" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-danger">Delete Doctor</button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables core -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <!-- DataTables Responsive -->
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        document.getElementById('doctorSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
			console.log(selectedOption);

            document.querySelector('[name="DoctorToDelete.ID"]').value = selectedOption.value;
            document.querySelector('[name="DoctorToDelete.Name"]').value = selectedOption.dataset.name;
            document.querySelector('[name="DoctorToDelete.Surname"]').value = selectedOption.dataset.surname;
            document.querySelector('[name="DoctorToDelete.Username"]').value = selectedOption.dataset.username;
            document.querySelector('[name="DoctorToDelete.Phone"]').value = selectedOption.dataset.phone;
            document.querySelector('[name="DoctorToDelete.Password"]').value = selectedOption.dataset.password;
            document.querySelector('[name="DoctorToDelete.Speciality"]').value = selectedOption.dataset.speciality;
            document.querySelector('[name="DoctorToDelete.Department"]').value = selectedOption.dataset.department;
        });
    </script>

}