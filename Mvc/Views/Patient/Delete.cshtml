@{
    ViewData["Title"] = "Edit Patients";
}
@using Hospital.Helpers;
@* @model Hospital.Models.Patient.PatientViewModel *@

@model Hospital.Models.Patient.PatientDeletePageViewModel;

@* Lista di Dipartimenti presenti nel sistema, ciascuno con un colore diverso *@
@{
    var departmentColors = DepartmentHelper.GetDepartmentColors();
    var departments = DepartmentHelper.GetDepartmentList().Select(d => d.Value);
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Total Patients</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
                    <li class="breadcrumb-item active">Edit Patient</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-12">
                <!-- Selezione del dottore -->
                <div class="form-group">
                    <label for="patientSelect">Select a Patient</label>
                    <select id="patientSelect" class="form-control select2" style="width: 100%;">
                        <option selected disabled>-</option>
                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.ID"
                                    data-name="@patient.Name"
                                    data-surname="@patient.Surname"
                                    data-username="@patient.Username"
                                    data-phone="@patient.Phone"
                                    data-password="@patient.Password"
                                    data-address="@patient.Address"
                                    data-age="@patient.Age">
                                @patient.Name @patient.Surname (@patient.Username)
                            </option>
                        }
                    </select>
                </div>

                <!-- Form di edit -->
                <form id="editPatientForm" asp-action="Delete" asp-controller="Patient" method="post">

                    <input type="hidden" asp-for="PatientToDelete.ID" />

                    <!-- Name -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Name"></label>
                        <input asp-for="PatientToDelete.Name" class="form-control" disabled/>
                        <span asp-validation-for="PatientToDelete.Name" class="text-danger"></span>
                    </div>

                    <!-- Surname -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Surname"></label>
                        <input asp-for="PatientToDelete.Surname" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Surname" class="text-danger"></span>
                    </div>

                    <!-- Username -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Username"></label>
                        <input asp-for="PatientToDelete.Username" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Username" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Password"></label>
                        <input asp-for="PatientToDelete.Password" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Password" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Phone"></label>
                        <input asp-for="PatientToDelete.Phone" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Phone" class="text-danger"></span>
                    </div>

                    <!-- Age -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Age"></label>
                        <input asp-for="PatientToDelete.Age" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Age" class="text-danger"></span>
                    </div>

                    <!-- Address -->
                    <div class="form-group">
                        <label asp-for="PatientToDelete.Address"></label>
                        <input asp-for="PatientToDelete.Address" class="form-control" disabled />
                        <span asp-validation-for="PatientToDelete.Address" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-danger">Delete Patient</button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables core -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <!-- DataTables Responsive -->
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        document.getElementById('patientSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            console.log(selectedOption);

            document.querySelector('[name="PatientToDelete.ID"]').value = selectedOption.value;
            document.querySelector('[name="PatientToDelete.Name"]').value = selectedOption.dataset.name;
            document.querySelector('[name="PatientToDelete.Surname"]').value = selectedOption.dataset.surname;
            document.querySelector('[name="PatientToDelete.Username"]').value = selectedOption.dataset.username;
            document.querySelector('[name="PatientToDelete.Phone"]').value = selectedOption.dataset.phone;
            document.querySelector('[name="PatientToDelete.Password"]').value = selectedOption.dataset.password;
            document.querySelector('[name="PatientToDelete.Age"]').value = selectedOption.dataset.age;
            document.querySelector('[name="PatientToDelete.Address"]').value = selectedOption.dataset.address;
        });
    </script>

}
