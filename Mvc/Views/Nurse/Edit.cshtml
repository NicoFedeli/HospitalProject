@{
    ViewData["Title"] = "Edit Nurses";
}
@using Hospital.Helpers;

@model Hospital.Models.Nurse.NurseEditPageViewModel;

@* Lista di Dipartimenti presenti nel sistema, ciascuno con un colore diverso *@
@{
    var departmentColors = DepartmentHelper.GetDepartmentColors();
    var departments = DepartmentHelper.GetDepartmentList().Select(d => d.Value);
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Total Nurses</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
                    <li class="breadcrumb-item active">Edit Nurse</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-12">
                <!-- Selezione del dottore -->
                <div class="form-group">
                    <label for="nurseSelect">Select a Nurse</label>
                    <select id="nurseSelect" class="form-control select2" style="width: 100%;">
                        <option selected disabled>-</option>
                        @foreach (var nurse in Model.Nurses)
                        {
                            <option value="@nurse.ID"
                                    data-name="@nurse.Name"
                                    data-surname="@nurse.Surname"
                                    data-username="@nurse.Username"
                                    data-phone="@nurse.Phone"
                                    data-department="@nurse.Department"
                                    data-password="@nurse.Password">
                                @nurse.Name @nurse.Surname (@nurse.Username)
                            </option>
                        }
                    </select>
                </div>

                <!-- Form di edit -->
                <form id="editNurseForm" asp-action="Edit" asp-controller="Nurse" method="post">

                    <input type="hidden" asp-for="NurseToEdit.ID" />

                    <!-- Name -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Name"></label>
                        <input asp-for="NurseToEdit.Name" class="form-control" />
                        <span asp-validation-for="NurseToEdit.Name" class="text-danger"></span>
                    </div>

                    <!-- Surname -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Surname"></label>
                        <input asp-for="NurseToEdit.Surname" class="form-control" />
                        <span asp-validation-for="NurseToEdit.Surname" class="text-danger"></span>
                    </div>

                    <!-- Username -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Username"></label>
                        <input asp-for="NurseToEdit.Username" class="form-control" />
                        <span asp-validation-for="NurseToEdit.Username" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Password"></label>
                        <input asp-for="NurseToEdit.Password" class="form-control" />
                        <span asp-validation-for="NurseToEdit.Password" class="text-danger"></span>
                    </div>

                    <!-- Department -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Department"></label>
                        <select asp-for="NurseToEdit.Department" class="form-control" asp-items="DepartmentHelper.GetDepartmentList()">
                            <option value="">Select Department</option>
                        </select>
                        <span asp-validation-for="NurseToEdit.Department" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label asp-for="NurseToEdit.Phone"></label>
                        <input asp-for="NurseToEdit.Phone" class="form-control" />
                        <span asp-validation-for="NurseToEdit.Phone" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables core -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <!-- DataTables Responsive -->
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <script>
        document.getElementById('nurseSelect').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            console.log(selectedOption);

            document.querySelector('[name="NurseToEdit.ID"]').value = selectedOption.value;
            document.querySelector('[name="NurseToEdit.Name"]').value = selectedOption.dataset.name;
            document.querySelector('[name="NurseToEdit.Surname"]').value = selectedOption.dataset.surname;
            document.querySelector('[name="NurseToEdit.Username"]').value = selectedOption.dataset.username;
            document.querySelector('[name="NurseToEdit.Phone"]').value = selectedOption.dataset.phone;
            document.querySelector('[name="NurseToEdit.Password"]').value = selectedOption.dataset.password;
            document.querySelector('[name="NurseToEdit.Department"]').value = selectedOption.dataset.department;
        });
    </script>

}
