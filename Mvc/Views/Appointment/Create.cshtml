@{
    ViewData["Title"] = "Create Appointment";
}
@* Prendo i campi dei department *@
@using Hospital.Models.Enums;
@using Newtonsoft.Json; @* Per serializzare in JSON *@
@model Hospital.Models.Appointment.CreateAppointmentViewModel;
@* Lista di Dipartimenti presenti nel sistema, ciascuno con un colore diverso *@
@{
    var departmentColors = new Dictionary<Department, string>
    {
        { Department.Cardiology, "bg-danger" },      // rosso
        { Department.Neurology, "bg-primary" },      // blu
        { Department.Pediatrics, "bg-warning" },     // giallo
        { Department.Emergency, "bg-success" },      // verde
        { Department.General, "bg-info" }            // azzurro
    };

    var departments = Enum.GetValues(typeof(Department)).Cast<Department>();
}

<head>
    <!-- Font Awesome (icone) -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">

    <!-- Select2 (Per il menù a tendina) -->
    <link rel="stylesheet" href="~/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">

    <!-- AdminLTE Theme -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>


<!-- SELECT2 EXAMPLE -->
<div class="card card-default">
    <div class="card-header">
        <h3 class="card-title">Create new Appointment</h3>

        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
           @*  <button type="button" class="btn btn-tool" data-card-widget="remove">
                <i class="fas fa-times"></i>
            </button> *@
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form asp-action="Create" asp-controller="Appointment" method="post">

                    <!-- Doctor -->
                    <div class="form-group">
                        <label asp-for="Appointment.IDDoctor">Select a Doctor</label>
                        <select class="form-control select2" style="width: 100%;" asp-for="Appointment.IDDoctor">
                            <option selected="selected">-</option>
                            @foreach (var doctor in Model.Doctors)
                            {
                                <option value="@doctor.ID">@doctor.Name @doctor.Surname (@doctor.Username)</option>
                            }
                        </select>
                        <span asp-validation-for="Appointment.IDDoctor" class="text-danger"></span>
                    </div>

                    <!-- Nurse -->
                    <div class="form-group">
                        <label asp-for="Appointment.IDNurse">Select a Nurse</label>
                        <select class="form-control select2" style="width: 100%;" asp-for="Appointment.IDNurse">
                            <option selected="selected">-</option>
                            @foreach (var patient in Model.Nurses)
                            {
                                <option value="@patient.ID">@patient.Name @patient.Surname (@patient.Username)</option>
                            }
                        </select>
                        <span asp-validation-for="Appointment.IDNurse" class="text-danger"></span>
                    </div>

                    <!-- Patient -->
                    <div class="form-group">
                        <label asp-for="Appointment.IDPatient">Select a Patient</label>
                        <select class="form-control select2" style="width: 100%;" asp-for="Appointment.IDPatient">
                            <option selected="selected">-</option>
                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.ID">@patient.Name @patient.Surname (@patient.Username)</option>
                            }
                        </select>
                        <span asp-validation-for="Appointment.IDPatient" class="text-danger"></span>
                    </div>

                    <!-- Department -->
                    <div class="form-group">
                        <label asp-for="Appointment.Department">Select a Department</label>
                        <select class="form-control select2" style="width: 100%;" asp-for="Appointment.Department">
                            <option selected="selected">-</option>
                            @foreach (var department in departments)
                            {
                                var cssClass = departmentColors.ContainsKey(department) ? departmentColors[department] : "bg-secondary";
                                <option value="@department" class="@cssClass">@department.ToString()</option>
                            }
                        </select>
                        <span asp-validation-for="Appointment.Department" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Appointment.Date">Appointment Date</label>
                        <input type="datetime-local" name="Appointment.Date" class="form-control" />
                        <span asp-validation-for="Appointment.Date" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Create Appointment</button>
                </form>
            </div>
        </div>
    </div>
</div>



<!-- jQuery -->
<script src="~/plugins/jquery/jquery.min.js"></script>

<!-- Bootstrap 4 -->
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script> 

<!-- Select2 -->
<script src="~/plugins/select2/js/select2.full.min.js"></script>

<!-- AdminLTE -->
<script src="~/dist/js/adminlte.min.js"></script>

<script>
    $(document).ready(function () {
        $('.select2').select2({
            theme: 'bootstrap4',
            minimumResultsForSearch: 0 // forza sempre la barra di ricerca
        });
    });
</script>

