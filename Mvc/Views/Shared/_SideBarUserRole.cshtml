@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var isAdmin = bool.TryParse(User.FindFirst("IsAdmin")?.Value, out var adminFlag) && adminFlag;
	Console.WriteLine($"Role: {role}, IsAdmin: {isAdmin}");
}

<!-- Doctor -->
@if (role == "Doctor" || role == "DoctorAdmin")
{
    @* menu-open mostra la tendina aperta  *@
    <li id="menu-doctor"  class="nav-item">
        @* active lo lascia bianco *@
        <a href="#" class="nav-link active">
            <i class="nav-icon fas fa-user-md"></i>
            <p>
                Doctor
                <i class="right fas fa-angle-left"></i>
            </p>
        </a>
        <ul class="nav nav-treeview">
            <li class="nav-item">
                <a asp-controller="Doctor" asp-action="Index" class="nav-link">
                    <i class="fas fa-search nav-icon"></i>
                    <p>Show all Doctors</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Doctor" asp-action="Edit" class="nav-link">
                    <i class="fas fa-edit nav-icon"></i>
                    <p>Edit one Doctor</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Doctor" asp-action="Delete" class="nav-link">
                    <i class="fas fa-trash nav-icon"></i>
                    <p>Delete one Doctor</p>
                </a>
            </li>
        </ul>
    </li>
}

