@using Hospital.Helpers
@using System.Security.Claims


@if (Context.User.Identity?.Name != null)
{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var isAdmin = bool.TryParse(User.FindFirst("IsAdmin")?.Value, out var adminFlag) && adminFlag;
    var title = GetRole.GetUserTitle(role);

    <ul class="nav navbar-nav navbar-right">
        <li class="nav-link">
            Hello @User.Identity.Name!
        </li>
        <li class="nav-link">
            <span class="badge badge-primary text-uppercase" style="font-size: 0.9rem; padding: 0.4em 0.8em; border-radius: 0.25rem; letter-spacing: 0.5px;">
                @title
            </span>
        </li>
        @* Forma Raccomandata per una POST *@
        <li>
            <form asp-controller="User" asp-action="LogOut" method="post" class="d-inline">
                <button type="submit" class="btn btn-link navbar-btn navbar-link">Log Out</button>
                @Html.AntiForgeryToken()
            </form>
        </li>

    </ul>
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a class="nav-link text-lightblue hover text-light" asp-controller="User" asp-action="SignUp">Register</a></li>
        <li><a class="nav-link text-lightblue hover text-light" asp-controller="User" asp-action="Login">Login</a></li>
    </ul>
}